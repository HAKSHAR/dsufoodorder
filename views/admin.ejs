<%- include('partials-header', {pageTitle:'Admin Dashboard', success, error}) %>
<main class="container admin-page"><div class="admin-heading"><div><p class="eyebrow">CONTROL CENTRE</p><h1>Admin dashboard</h1><p class="muted">Welcome, <%= admin.username %>. Manage your food ordering website here.</p></div><form method="post" action="/admin/logout"><button class="btn secondary" type="submit">Log out</button></form></div>
<div class="stats"><div class="stat"><span>Restaurants</span><strong><%= restaurantCount %></strong><small>All restaurants</small></div><div class="stat"><span>Menu items</span><strong><%= itemCount %></strong><small>Food and drinks</small></div><div class="stat"><span>New orders</span><strong><%= orderCount %></strong><small>Waiting for action</small></div></div>
<div class="admin-columns"><section class="panel"><div class="panel-heading"><div><p class="eyebrow">SET UP YOUR STORE</p><h2>Add restaurant</h2></div><span>🏪</span></div><form action="/admin/restaurants" method="post" class="stack"><label>Restaurant name<input class="field" name="name" required maxlength="150" placeholder="e.g. DSU Canteen"></label><label>Description<textarea class="field" name="description" rows="2" maxlength="500" placeholder="Short description"></textarea></label><label class="check"><input type="checkbox" name="is_active" checked> Show on customer website</label><button class="btn primary" type="submit">+ Add restaurant</button></form></section>
<section class="panel"><div class="panel-heading"><div><p class="eyebrow">YOUR STORES</p><h2>Manage restaurants</h2></div><span>⚙️</span></div><% if (!restaurants.length) { %><p class="muted">Your restaurants will appear here.</p><% } %><div class="manage-list"><% restaurants.forEach(r => { %><details class="restaurant-manage"><summary><span><strong><%= r.name %></strong><small><%= r.item_count %> menu items · <%= r.is_active?'Visible':'Hidden' %></small></span><span>⌄</span></summary><div class="manage-body"><form action="/admin/restaurants/<%= r.id %>/update" method="post" class="stack"><label>Name<input class="field" name="name" value="<%= r.name %>" required></label><label>Description<input class="field" name="description" value="<%= r.description %>"></label><label class="check"><input type="checkbox" name="is_active" <%= r.is_active?'checked':'' %>> Visible to customers</label><button class="btn secondary" type="submit">Save restaurant</button></form><a class="btn primary" href="/admin/restaurants/<%= r.id %>/menu">Manage menu →</a><form action="/admin/restaurants/<%= r.id %>/delete" method="post" onsubmit="return confirm('Delete this restaurant and its menu?')"><button class="danger-link" type="submit">Delete restaurant</button></form></div></details><% }) %></div></section></div>
<section class="panel orders-panel"><div class="panel-heading"><div><p class="eyebrow">RECENT ACTIVITY</p><h2>Orders from MySQL</h2></div><span>📦</span></div><div class="table-wrap"><table><thead><tr><th>Order</th><th>Restaurant</th><th>Items</th><th>Total</th><th>Status</th><th>Update</th></tr></thead><tbody><% orders.forEach(o => { %><tr><td>#<%= o.id %><small><%= new Date(o.created_at).toLocaleString('en-IN') %></small></td><td><%= o.restaurant_name %></td><td><% let lines = typeof o.items_json==='string' ? JSON.parse(o.items_json) : o.items_json; %><%= lines.map(i=>`${i.name} × ${i.quantity}`).join(', ') %></td><td><strong><%= money(o.total) %></strong></td><td><span class="status"><%= o.status %></span></td><td><form class="status-form" method="post" action="/admin/orders/<%= o.id %>/status"><select name="status"><% ['New','Confirmed','Preparing','Completed','Cancelled'].forEach(s=> { %><option <%= o.status===s?'selected':'' %>><%= s %></option><% }) %></select><button class="mini-btn">Save</button></form></td></tr><% }) %><% if (!orders.length) { %><tr><td colspan="6" class="muted">Orders will appear here after a customer checks out.</td></tr><% } %></tbody></table></div></section>
<div class="tip-box"><strong>Faculty demo tip:</strong> Add a restaurant, add menu items and upload photos, then open the customer page, add items to cart and click Order Now. Show the saved order in this dashboard and the records in MySQL Workbench.</div></main>
<%- include('partials-footer') %>
