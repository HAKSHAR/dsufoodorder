<%- include('partials-header', {pageTitle:'Manage Menu', success, error}) %>
<main class="container admin-page"><a class="back-link" href="/admin">← Back to dashboard</a><div class="admin-heading"><div><p class="eyebrow">RESTAURANT MENU</p><h1><%= restaurant.name %></h1><p class="muted">Add food, upload photos, edit prices, and control availability.</p></div><span class="restaurant-icon large">🍽️</span></div>
<div class="admin-columns"><section class="panel"><div class="panel-heading"><div><p class="eyebrow">NEW MENU ITEM</p><h2>Add food item</h2></div><span>➕</span></div><form action="/admin/restaurants/<%= restaurant.id %>/menu" method="post" enctype="multipart/form-data" class="stack"><label>Food name<input class="field" name="name" required maxlength="150" placeholder="e.g. Masala Dosa"></label><label>Description<textarea class="field" name="description" rows="2" maxlength="500" placeholder="Ingredients or short details"></textarea></label><div class="form-row"><label>Category<input class="field" name="category" placeholder="South Indian" maxlength="80"></label><label>Price (₹)<input class="field" name="price" type="number" min="0" step="0.01" required placeholder="80"></label></div><label>Food photo (JPG, PNG, WEBP; max 4 MB)<input class="field file-field" name="photo" type="file" accept="image/jpeg,image/png,image/webp"></label><label class="check"><input type="checkbox" name="is_available" checked> Available to order</label><button class="btn primary">Add menu item</button></form></section>
<section class="panel"><div class="panel-heading"><div><p class="eyebrow">CURRENT MENU</p><h2>Food items <span class="count"><%= items.length %></span></h2></div></div><div class="manage-list"><% items.forEach(item => { %><details class="restaurant-manage menu-manage"><summary><% if (item.photo) { %><img class="tiny-photo" src="<%= item.photo %>" alt=""><% } else { %><span class="tiny-photo emoji-photo">🍲</span><% } %><span class="item-summary"><strong><%= item.name %></strong><small><%= item.category %> · <%= money(item.price) %> · <%= item.is_available?'Available':'Hidden' %></small></span><span>⌄</span></summary><div class="manage-body"><form action="/admin/menu/<%= item.id %>/update" method="post" enctype="multipart/form-data" class="stack"><label>Name<input class="field" name="name" value="<%= item.name %>" required></label><label>Description<textarea class="field" name="description" rows="2"><%= item.description %></textarea></label><div class="form-row"><label>Category<input class="field" name="category" value="<%= item.category %>"></label><label>Price (₹)<input class="field" type="number" name="price" min="0" step="0.01" value="<%= item.price %>" required></label></div><label>Replace photo<input class="field file-field" type="file" name="photo" accept="image/jpeg,image/png,image/webp"></label><label class="check"><input type="checkbox" name="is_available" <%= item.is_available?'checked':'' %>> Available to customers</label><button class="btn secondary">Save changes</button></form><form action="/admin/menu/<%= item.id %>/delete" method="post" onsubmit="return confirm('Delete this menu item?')"><button class="danger-link">Delete item</button></form></div></details><% }) %><% if (!items.length) { %><p class="muted">No menu items yet. Add the first item using the form.</p><% } %></div></section></div></main>
<%- include('partials-footer') %>
