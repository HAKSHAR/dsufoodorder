<%- include('partials-header', {pageTitle:'Order Food', success, error}) %>
<main class="container">
  <section class="hero"><div><p class="eyebrow">DAYANANDA SAGAR UNIVERSITY</p><h1>Good food.<br><span>Easy ordering.</span></h1><p>Choose a restaurant, build your cart, and send your order through WhatsApp.</p><a class="btn primary" href="#restaurants">Explore restaurants</a></div><div class="hero-art">🍔<span>🍕</span><b>🥤</b></div></section>
  <section id="restaurants" class="section"><div class="section-head"><div><p class="eyebrow">FIND YOUR FAVOURITE</p><h2>Choose a restaurant</h2></div><span class="muted"><%= restaurants.length %> available</span></div>
    <% if (!restaurants.length) { %><div class="empty"><div class="empty-icon">🍽️</div><h3>No restaurants yet</h3><p>The admin can log in and add the first restaurant.</p><a class="btn secondary" href="/admin/login">Admin login</a></div><% } %>
    <div class="restaurant-grid"><% restaurants.forEach((r, i) => { %><button class="restaurant-card <%= i===0?'selected':'' %>" data-restaurant="<%= r.id %>"><span class="restaurant-icon"><%= ['🍛','🍕','🥗','🍜','🍔'][i%5] %></span><span><strong><%= r.name %></strong><small><%= r.description || 'Fresh food, ready to order' %></small></span><span class="arrow">↗</span></button><% }) %></div>
  </section>
  <section class="section"><div class="section-head"><div><p class="eyebrow">MADE FOR YOUR CRAVINGS</p><h2>Explore the menu</h2></div><input id="search" class="search" placeholder="Search food..." aria-label="Search food"></div>
    <div class="menu-layout"><div class="menu-grid" id="menuGrid"><% items.forEach((item, i) => { %><article class="food-card" data-id="<%= item.id %>" data-restaurant="<%= item.restaurant_id %>" data-name="<%= item.name.toLowerCase() %>" data-category="<%= item.category.toLowerCase() %>" data-price="<%= item.price %>"><div class="food-photo"><% if (item.photo) { %><img src="<%= item.photo %>" alt="<%= item.name %>"><% } else { %><div class="food-placeholder"><%= ['🍛','🍕','🥪','🍜','🥘','🥗'][i%6] %></div><% } %><span class="category-tag"><%= item.category %></span></div><div class="food-info"><div><h3><%= item.name %></h3><p><%= item.description || item.restaurant_name %></p></div><div class="food-bottom"><strong><%= money(item.price) %></strong><button class="add-btn" data-add="<%= item.id %>" data-restaurant="<%= item.restaurant_id %>" data-name="<%= item.name %>" data-price="<%= item.price %>">+ Add</button></div></div></article><% }) %></div>
      <aside class="cart" id="cart"><div class="cart-title"><div><p class="eyebrow">YOUR ORDER</p><h2>My cart <span id="cartCount" class="count">0</span></h2></div><span>🛒</span></div><div id="cartItems" class="cart-items"><div class="cart-empty"><span>🛍️</span><p>Your cart is empty</p><small>Add something delicious!</small></div></div><div class="cart-total"><span>Total</span><strong id="cartTotal">₹0.00</strong></div><label class="field-label" for="customerName">Name (optional)</label><input id="customerName" class="field" maxlength="120" placeholder="Your name"><button id="orderNow" class="btn primary order-btn" disabled>Order now on WhatsApp <span>↗</span></button><small class="cart-note">Your order is saved in the project database when you continue.</small></aside>
    </div>
  </section>
</main>
<script>window.DSU_MENU = <%- JSON.stringify(items.map(i=>({id:i.id,restaurant_id:i.restaurant_id,name:i.name,price:Number(i.price),photo:i.photo,category:i.category}))).replace(/</g,'\\u003c') %>; window.DSU_WHATSAPP = '<%= whatsapp %>';</script><script src="/js/app.js"></script>
<%- include('partials-footer') %>
